        // Optimal - Using LL + no extra space used
        ListNode *l1 = list1;
        ListNode *l2 = list2;

        ListNode *dummy = new ListNode(0); // whenever you need to create a new node, always use dummy, because it is easy to have it
        ListNode *t = dummy;

        

        while(l1 != NULL && l2 != NULL)
        {
            if(l1->val <= l2->val)
