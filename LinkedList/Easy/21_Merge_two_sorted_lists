                t->next = l1;
                t = l1;
                l1 = l1->next;
            }

            else
            {
                t->next = l2;
                t = l2;
                l2 = l2->next;
            }
        }

        while(l1 != NULL)
        {
            t->next = l1;
            t = l1;
            l1 = l1->next;
        }

        while(l2 != NULL)
        {
            t->next = l2;
            t = l2;
            l2 = l2->next;
        }

        return dummy->next;
    }
