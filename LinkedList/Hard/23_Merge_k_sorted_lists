        for(int i = 0; i < arr.size(); i++)
        {
            t->next = new ListNode(arr[i]);
            t = t->next;
        }

        return dummy->next;
        */

        if(lists.size() == 0) return NULL;
        if(lists.size() == 1) return lists[0];

        int n = lists.size();
        int i = 0;
        while((i+1) < n)
        {
            lists[0] = merge_two_Lists(lists[0], lists[i+1]);
            i++;
        }

        return lists[0];
    }
};
