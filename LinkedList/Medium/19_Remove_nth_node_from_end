Given the head of a linked list, remove the nth node from the end of the list and return its head.

 

Example 1:


Input: head = [1,2,3,4,5], n = 2
Output: [1,2,3,5]
Example 2:

Input: head = [1], n = 1
Output: []
Example 3:

Input: head = [1,2], n = 1
Output: [1]
 

Constraints:

The number of nodes in the list is sz.
1 <= sz <= 30
0 <= Node.val <= 100
1 <= n <= sz
 

Follow up: Could you do this in one pass?




/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        /*
        //Approach - 1 using size of LL -> pattern seeing
        //TC - O(N)
        //SC - O(1)
        int count = 0;

        ListNode* temp = head;

        while(temp != NULL)
        {
            count++;
            temp = temp->next;
        }

        if(count == 1)
        {
            return NULL;
        }

        if(count == n)
        {
            head = head->next;
            return head;
        }

        int i = 0;
        ListNode *curr = head;
        while(i != (count - n - 1))
        {
            
            curr = curr->next;
            i++;
        }

        curr->next = curr->next->next;

        return head;
        */

        // Approach - 2 -> slow and fast pointer
        //TC - O(N)
        //SC - O(1)
        ListNode* slow = head;
        ListNode* fast = head;

        while(n--)
        {
            fast = fast->next;
        }

        // Edge case n == size
        if(fast == NULL)
        {
            return head->next;
        }

        // Done

        ListNode* prev = NULL;

        while(fast != NULL)
        {
            prev = slow;
            slow = slow->next;
            fast = fast->next;
        }

        prev->next = slow->next;
        return head;
    }
};
