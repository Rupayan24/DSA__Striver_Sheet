        // Optimal Approach
        // TC - O(N)
        // SC - O(1)
        if(head == NULL) return head;
        ListNode* odd_head = head;
        ListNode* even_head = head->next;

        ListNode* odd = odd_head;
        ListNode* even = even_head;

        while(even != NULL && even->next != NULL)  //  this while loop comes from checking this :- even->next->next
        // if temp is already NULL then temp->next is invalid .. we need to take this into consideration
        // (temp->next)->next is invalid if temp->next is NULL ---> i.e even->next != NULL is done
        // (temp)->next)...... ->next is also invalid if temp is NULL ---> i.e even != NULL is done
        {
            odd->next = odd->next->next;
            even->next = even->next->next;
            odd = odd->next;
            even = even->next;
        }

        odd->next = even_head;
        return odd_head;
        
    }
};
