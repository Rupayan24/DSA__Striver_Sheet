class Solution {
public:
    int countStudents(vector<int>& students, vector<int>& sandwiches) {
        int n = students.size();
        queue<int> q_student;
        queue<int> q_sand;
        int count = 0;

        for(int i = 0; i < n; i++)
        {
            q_student.push(students[i]);
            q_sand.push(sandwiches[i]);
        }

        while(count < q_student.size())
        {
            if(q_student.front() == q_sand.front())
            {
                count = 0;
                q_student.pop();
                q_sand.pop();
            }

            else
            {
                count++;
                q_student.push(q_student.front());
                q_student.pop();
            }


        }

        int a = q_student.size();

        return a;
    }
};



