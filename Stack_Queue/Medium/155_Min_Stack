// Approach - using stack + pair --> better
// TC - O(1)
// SC - O(N) // as stack is used
class MinStack {
public:
stack<pair<int, int>> s;
    MinStack() {
        
    }
    
    void push(int val) {
        if(s.empty()) s.push({val, val});
        else
        {
            s.push({val, min(val, s.top().second)});
        }
    }
    
    void pop() {
        s.pop();
    }
    
    int top() {
        return s.top().first;
    }
    
    int getMin() {
        return s.top().second;
    }
};

