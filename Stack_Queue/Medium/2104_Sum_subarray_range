        // Approach --> Using sum of subarray minimum & sum of subarray maximum 
        // TC - O(5N) + O(5N) ----> O(N)
        // SC - O(5N) + O(5N) ----> O(N)



        // TC - O(N)
        // SC - O(N)
        int n = nums.size();

        //For finding previous smallest or equal to element on left side for each index
        vector<long long> left(n);
        stack<long long> s1;

        for(long long i = 0; i < n; i++)
        {
            while(!s1.empty() && nums[s1.top()] > nums[i]) // to find smaller as well as equal element on left side
            {
                s1.pop();
            }
            if(s1.empty())
            {
                left[i] = -1;
            }
            else
            {
                left[i] = s1.top();
            }
            s1.push(i);
        }


        // For finding next smallest element on the right of the index
        vector<long long> right(n);
        stack<long long> s2;
        for(long long i = n-1; i >= 0; i--)
        {
            while(!s2.empty() && nums[s2.top()] >= nums[i])
            {
                s2.pop();
            }

            if(s2.empty())
            {
                right[i] = n;
            }

            else
            {
                right[i] = s2.top();
            }

            s2.push(i);
        }
        long long total = 0;
        long long mod = 1e9 + 7;

        for(long long i = 0; i < n; i++)
        {
            long long prod = ((left[i] - i) * (i - right[i]));
            long long contribution = (nums[i] * prod);
            total += contribution;
            total = total;
        }

        // TC - O(N)
        // SC - O(N)
        

        //For finding previous largest or equal to element on left side for each index
        vector<long long> meft(n);
        stack<long long> m1;

        for(long long i = 0; i < n; i++)
        {
            while(!m1.empty() && nums[m1.top()] < nums[i]) // to find largest as well as equal element on left side
            {
                m1.pop();
            }
            if(m1.empty())
            {
                meft[i] = -1;
            }
            else
            {
                meft[i] = m1.top();
            }
            m1.push(i);
        }


        // For finding next largest element on the right of the index
        vector<long long> might(n);
        stack<long long> m2;
        for(long long i = n-1; i >= 0; i--)
        {
            while(!m2.empty() && nums[m2.top()] <= nums[i])
            {
                m2.pop();
            }

            if(m2.empty())
            {
                might[i] = n;
            }

            else
            {
                might[i] = m2.top();
            }

            m2.push(i);
        }
        long long motal = 0;
        long long lod = 1e9 + 7;

        for(long long i = 0; i < n; i++)
        {
            long long mrod = ((meft[i] - i) * (i - might[i]));
            long long montribution = (nums[i] * mrod);
            motal += montribution;
            motal = motal;
        }

        return (motal - total); // sum of all largest - sum of all smallest
    }
};
