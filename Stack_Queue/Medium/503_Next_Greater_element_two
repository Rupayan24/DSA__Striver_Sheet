        // Approach 4 - Optimal -- > hypotheticaly increasing size.... size is not increased in reality --> so no extra space used in that scenerio
        // TC - O(N)
        // SC - O(N)
        stack<int> s;
        int n = nums.size();
        vector<int> res(n);

        for(int i = 2*n-1; i >= 0; i--)
        {
            while(!s.empty() && s.top() <= nums[i % n])
            {
                s.pop();
            }

            if(i < n)
            {
                res[i] = s.empty() ? -1 : s.top();
            }

            s.push(nums[i%n]);
        }

        

        return res;

        
